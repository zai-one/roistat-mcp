# File paths only; never commit real keys or state.
ROISTAT_API_KEY_FILE=/run/secrets/roistat-api-key
ROISTAT_STATE_PATH=/state/roistat.sqlite
ROISTAT_ACCOUNT_ID=default
ROISTAT_LOCAL_PRINCIPAL=local-operator
ROISTAT_MCP_PUBLIC_KEY_FILE=/run/config/roistat-public.pem
ROISTAT_MCP_ISSUER=roistat-operator
ROISTAT_MCP_AUDIENCE=roistat-mcp
ROISTAT_PROJECT_ALLOWLIST=
ROISTAT_WRITE_ENABLED=false
ROISTAT_WRITE_OPERATIONS=
ROISTAT_RATE_LIMIT=30
ROISTAT_PRINCIPAL_RATE_LIMIT=30
ROISTAT_MAX_CONCURRENCY=1
# Set to 1 to disable the GitHub release check (roistat_check_update).
ROISTAT_DISABLE_UPDATE_CHECK=0
