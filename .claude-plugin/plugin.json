{
  "name": "roistat",
  "version": "0.5.0",
  "description": "Roistat marketing analytics (channels, ROI, leads, calls) with approval-gated writes and agent skills",
  "author": {
    "name": "ZAI.ONE",
    "url": "https://github.com/zai-one"
  },
  "homepage": "https://github.com/zai-one/roistat-mcp",
  "repository": "https://github.com/zai-one/roistat-mcp",
  "license": "LicenseRef-ZAI-ONE",
  "skills": "./skills/",
  "mcpServers": {
    "roistat": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/zai-one/roistat-mcp@v0.5.0",
        "roistat-mcp"
      ],
      "env": {
        "ROISTAT_API_KEY_FILE": "${ROISTAT_API_KEY_FILE}",
        "ROISTAT_PROJECT_ALLOWLIST": "${ROISTAT_PROJECT_ALLOWLIST}",
        "ROISTAT_STATE_PATH": "${ROISTAT_STATE_PATH}"
      }
    }
  }
}
